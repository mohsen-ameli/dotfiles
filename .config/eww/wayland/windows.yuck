(defwindow bar
    :monitor 1
    :windowtype "dock"
    :geometry (geometry :anchor "top center" :height "43px" :width "100%")
    :wm-ignore false
    :exclusive true
    ; :reserve (struts :side "top" :distance "100px")
    (bar)
)
  
(defwindow time_cal
    :monitor 1
    :stacking "overlay"
    :geometry (geometry 
                :anchor "top right"
                :width "350px"
                :x "5px"
                :y "5px"
            )
    (time_cal)
)

(defwindow control
    :monitor 1
    :stacking "overlay"
    :geometry (geometry
                :anchor "top right"
                :width "350px"
                :height "100px"
                :x "5px"
                :y "5px"
            )
    (control)
)

(defwindow wifi
    :monitor 1
    :stacking "overlay"
    :geometry (geometry 
                :anchor "top right"
                :width "400px"
                :height "100px"
                :x "130px"
                :y "5px"
            )
    (wifi)
)

(defwindow bluetooth
    :monitor 1
    :stacking "overlay"
    :geometry (geometry 
                :anchor "top right"
                :width "300px"
                :height "100px"
                :x "100px"
                :y "5px"
            )
    (bluetooth)
)

(defwindow battery
    :monitor 1
    :stacking "overlay"
    :geometry (geometry 
                :anchor "top right"
                :width "300px"
                :height "100px"
                :x "20px"
                :y "5px"
            )
    (battery)
)

(defwindow weather
    :monitor 1
    :stacking "overlay"
    :geometry (geometry 
                :anchor "top left"
                :width "380px"
                :x "150px"
                :y "5px"
            )
    (weather)
)

(defwindow updates
    :monitor 1
    :stacking "overlay"
    :geometry (geometry 
                :anchor "top right"
                :width "500px"
                :x "360px"
                :y "5px"
            )
    (updates)
)

(defwindow menu-closer
    :monitor 1
    :geometry (geometry
                :width "1920px"
                :height "1080px"
            )
    :stacking "fg"
    :focusable false
    (button :onclick "../scripts/toggle.sh \"${curr_window}\"")
)
