configuration {
    dpi: 144;
    display-drun: "Application:";
    display-window: "Windows:";
    drun-display-format: "{icon} {name}";
    // hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    modes: [window,drun,run,ssh,calc,emoji];
    show-icons: true;
    scale: 2;
}

@theme "themes/nord.rasi"

element-icon {
    size: 32px; /* Change this value to scale icons up or down */
}