#!/bin/sh
##########################
## Shows a dmenu page with all available videos in a given directory
##########################

player="vlc" # "mpv"

while true; do
  p=$([ "$1" != "" ] && echo "$1" || echo ".")

  find "$p" -name "*.mp4" -or -name "*.mkv" -or -name "*.mov" | rofi -dmenu | xargs -I {} $player "{}"
done

